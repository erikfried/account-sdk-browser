{
  "name": "@schibsted/account-sdk-browser",
  "version": "5.2.5",
  "description": "Schibsted account SDK for browsers",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": ["dist", "index.d.ts"],
  "scripts": {
    "build": "vite build",
    "clean": "rimraf .cache coverage dist docs",
    "docs": "rimraf docs && jsdoc -c ./jsdoc.conf.json --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "cover": "jest --coverage",
    "preversion": "npm run lint && npm test",
    "version": "node ./scripts/genversion.js && git add src/version.js",
    "postversion": "git push && git push --tags"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "tiny-emitter": "^2.1.0"
  },
  "devDependencies": {
    "docdash": "git+https://github.com/torarvid/docdash.git#v0.5.0",
    "eslint": "^6.8.0",
    "eslint-plugin-import": "^2.20.2",
    "jest": "^26.4.2",
    "jest-junit": "^10.0.0",
    "jsdoc": "^3.6.11",
    "node-fetch": "^2.6.0",
    "vite": "^7.3.1",
    "whatwg-url": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/schibsted/account-sdk-browser.git"
  },
  "typings": "index.d.ts"
}
